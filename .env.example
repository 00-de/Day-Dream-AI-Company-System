# ============================================================
# 【1】Firebase の設定（ブラウザに出てOKな値）
#     Firebaseコンソール → プロジェクトの設定 → マイアプリ
# ============================================================

VITE_FIREBASE_API_KEY=ここにapiKey
VITE_FIREBASE_AUTH_DOMAIN=ここにauthDomain
VITE_FIREBASE_PROJECT_ID=ここにprojectId
VITE_FIREBASE_STORAGE_BUCKET=ここにstorageBucket
VITE_FIREBASE_MESSAGING_SENDER_ID=ここにmessagingSenderId
VITE_FIREBASE_APP_ID=ここにappId


# ============================================================
# 【2】AIのAPIキー（絶対に VITE_ を付けないでください）
#     VITE_ を付けるとブラウザに丸見えになり、悪用されます。
#     この3つは /api/chat（サーバー側）だけが読み込みます。
#     3つ全部は不要です。1つでも入れれば動きます。
#     優先順： Groq → Gemini → OpenAI → Claude
# ============================================================

# Groq（無料枠が大きく、返答が速いのでおすすめ） https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Claude（Anthropic）  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# ============================================================
# 【3】Stability AI（画像生成）のAPIキー
#     https://platform.stability.ai/account/keys
#     これも VITE_ は付けないでください
# ============================================================

STABILITY_API_KEY=


# ============================================================
# 【4】Web検索のAPIキー（AI社員が調べものをするときに使います）
#     どちらか片方でも動きます。両方入れると自動で切り替わります。
# ============================================================

# Tavily（AI向け検索・ページ本文まで返す・月1000回無料）
#   https://app.tavily.com/
TAVILY_API_KEY=

# Brave Search（月2000回無料）
#   https://api-dashboard.search.brave.com/
BRAVE_API_KEY=

# 1 にすると、呼び出しごとに Tavily と Brave を交互に使います
# （両方の無料枠を使い切りたい場合に設定してください）
SEARCH_ROTATE=


# ── 使うモデルを変えたいとき（未設定なら下の既定値が使われます） ──
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5
